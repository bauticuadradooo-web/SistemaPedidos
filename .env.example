# Creá un bot con @BotFather y pegá el token entre comillas.
TELEGRAM_BOT_TOKEN=""
# Alias de demostración. Antes de cobrar, reemplazalo por el alias real de la cuenta receptora.
TRANSFER_ALIAS="DELY.DRINKS"
# En un sitio con HTTPS público, cambiar a true.
PANEL_COOKIE_SECURE="false"

# La base nueva del comercio queda separada de la base con datos de prueba.
DATABASE_URL="sqlite:///./database/pedidos_comercio.db"
